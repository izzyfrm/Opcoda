      "source": "def merge_dicts(left, right):\n    result = {}\n    for key in set(left) | set(right):\n        if key in left and key in right:\n            result[key] = max(left[key], right[key])\n        elif key in left:\n            result[key] = left[key]\n        else:\n            result[key] = right[key]\n    return result\n"
