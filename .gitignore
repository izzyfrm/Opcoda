# Python
.venv/
__pycache__/
*.pyc
*.pyo

# Secrets / local editor stuff
.env
.coda-model-token
tunnel/*.json
tunnel/opcoda-model.yml
.vscode/

# Model checkpoints
checkpoints/*.pt

# Generated training data
data/train.bin
